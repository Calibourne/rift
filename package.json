{
  "name": "rift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && cargo clean --manifest-path src-tauri/Cargo.toml",
    "clean:frontend": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "clean:rust": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "build:win": "npm run build && npm run tauri build -- --bundles msi,nsis",
    "build:mac": "npm run build && npm run tauri build -- --bundles dmg",
    "build:linux": "npm run build && npm run tauri build -- --bundles deb,appimage",
    "build:release": "npm run clean && npm run build:win"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^5.4.0"
  }
}